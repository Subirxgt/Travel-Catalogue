<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Travel Catalogue</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Header -->
    <header>
        <div class="container header-content">

            <a href="/" class="logo">
                ✈ Travel<span>Catalogue</span>
            </a>

            <a href="/destinations/add" class="add-btn">
                + Add Destination
            </a>

        </div>
    </header>


    <main class="container">

        <!-- Hero Section -->
        <section class="hero">

            <h1>Discover Your Next Destination</h1>

            <p>
                Explore beautiful places around the world,
                discover new experiences, and plan your next adventure.
            </p>

        </section>


        <!-- Filter Section -->
        <section class="filter-box">

            <div class="filter-title">
                🔎 Find Your Destination
            </div>

            <form action="/" method="GET" class="filter-form">

                <!-- Category -->
                <div>
                    <label for="category">Category</label>

                    <select id="category" name="category">

                        <option value="">All Categories</option>

                        <option value="Mountain"
                            <%= filters.category === "Mountain" ? "selected" : "" %>>
                            Mountain
                        </option>

                        <option value="Beach"
                            <%= filters.category === "Beach" ? "selected" : "" %>>
                            Beach
                        </option>

                        <option value="Heritage"
                            <%= filters.category === "Heritage" ? "selected" : "" %>>
                            Heritage
                        </option>

                        <option value="Adventure"
                            <%= filters.category === "Adventure" ? "selected" : "" %>>
                            Adventure
                        </option>

                        <option value="Wildlife"
                            <%= filters.category === "Wildlife" ? "selected" : "" %>>
                            Wildlife
                        </option>

                        <option value="City"
                            <%= filters.category === "City" ? "selected" : "" %>>
                            City
                        </option>

                    </select>
                </div>


                <!-- Country -->
                <div>

                    <label for="country">Country</label>

                    <input
                        type="text"
                        id="country"
                        name="country"
                        placeholder="e.g. India"
                        value="<%= filters.country %>"
                    >

                </div>


                <!-- Budget -->
                <div>

                    <label for="budget">Budget</label>

                    <select id="budget" name="budget">

                        <option value="">All Budgets</option>

                        <option value="Low"
                            <%= filters.budget === "Low" ? "selected" : "" %>>
                            Low
                        </option>

                        <option value="Medium"
                            <%= filters.budget === "Medium" ? "selected" : "" %>>
                            Medium
                        </option>

                        <option value="High"
                            <%= filters.budget === "High" ? "selected" : "" %>>
                            High
                        </option>

                    </select>

                </div>


                <!-- Season -->
                <div>

                    <label for="bestSeason">Best Season</label>

                    <select id="bestSeason" name="bestSeason">

                        <option value="">All Seasons</option>

                        <option value="Spring"
                            <%= filters.bestSeason === "Spring" ? "selected" : "" %>>
                            Spring
                        </option>

                        <option value="Summer"
                            <%= filters.bestSeason === "Summer" ? "selected" : "" %>>
                            Summer
                        </option>

                        <option value="Monsoon"
                            <%= filters.bestSeason === "Monsoon" ? "selected" : "" %>>
                            Monsoon
                        </option>

                        <option value="Autumn"
                            <%= filters.bestSeason === "Autumn" ? "selected" : "" %>>
                            Autumn
                        </option>

                        <option value="Winter"
                            <%= filters.bestSeason === "Winter" ? "selected" : "" %>>
                            Winter
                        </option>

                    </select>

                </div>


                <!-- Filter Button -->
                <button type="submit" class="filter-btn">
                    🔍 Filter
                </button>

            </form>

        </section>


        <!-- Results Header -->
        <div class="section-header">

            <h2>Available Destinations</h2>

            <span class="destination-count">
                <%= destinations.length %>
                <%= destinations.length === 1 ? "destination" : "destinations" %>
            </span>

        </div>


        <!-- Results -->
        <% if (destinations.length === 0) { %>

            <div class="empty-state">

                <div style="font-size: 3rem; margin-bottom: 10px;">
                    🌍
                </div>

                <h3>No destinations found</h3>

                <p>
                    Try changing your filters or add a new destination.
                </p>

                <br>

                <a href="/destinations/add" class="add-btn">
                    + Add Destination
                </a>

            </div>

        <% } else { %>


            <div class="destination-grid">

                <% destinations.forEach(destination => { %>

                    <article class="destination-card">

                        <!-- Image -->
                        <% if (destination.imageUrl) { %>

                            <img
                                src="<%= destination.imageUrl %>"
                                alt="<%= destination.name %>"
                                class="destination-image"
                            >

                        <% } else { %>

                            <div class="destination-placeholder">
                                🌄
                            </div>

                        <% } %>


                        <!-- Card Content -->
                        <div class="destination-content">

                            <h3 class="destination-title">
                                <%= destination.name %>
                            </h3>


                            <p class="destination-country">
                                📍 <%= destination.country %>
                            </p>


                            <!-- Tags -->
                            <div class="destination-meta">

                                <span class="badge">
                                    <%= destination.category %>
                                </span>

                                <span class="badge">
                                    💰 <%= destination.budget %>
                                </span>

                                <span class="badge">
                                    🗓 <%= destination.bestSeason %>
                                </span>

                            </div>


                            <!-- Rating -->
                            <p class="rating">
                                ⭐ <%= destination.rating %> / 5
                            </p>


                            <!-- Description -->
                            <p class="destination-description">
                                <%= destination.description %>
                            </p>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } %>

    </main>


    <!-- Footer -->
    <footer>

        <div class="container">

            <p>
                © 2026 Travel Catalogue · Explore. Discover. Travel.
            </p>

        </div>

    </footer>

</body>

</html>